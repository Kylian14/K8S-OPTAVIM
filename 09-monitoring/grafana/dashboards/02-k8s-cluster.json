{
  "uid": "opta-k8s-cluster",
  "title": "OPTAVIM — Cluster Kubernetes",
  "tags": ["optavim", "k8s"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "templating": {"list": [
    {"name": "datasource", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}, "hide": 0}
  ]},
  "links": [
    {"title": "Executive", "url": "/d/opta-exec", "type": "link", "icon": "external link"},
    {"title": "K8s Workloads", "url": "/d/opta-k8s-wl", "type": "link", "icon": "external link"}
  ],
  "panels": [
    {"id": 1, "type": "row", "title": "Serveurs", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},
    {
      "id": 2, "type": "table", "title": "État des serveurs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "kube_node_status_condition{condition=\"Ready\"}", "refId": "A", "format": "table", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}}
    },
    {
      "id": 3, "type": "timeseries", "title": "Applications par espace",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\"})", "refId": "A", "legendFormat": "{{namespace}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}}
    },
    {"id": 10, "type": "row", "title": "Ressources", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}},
    {
      "id": 11, "type": "timeseries", "title": "CPU par serveur",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "percent", "min": 0, "max": 100}}
    },
    {
      "id": 12, "type": "timeseries", "title": "Mémoire par serveur",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 10},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "percent", "min": 0, "max": 100}}
    },
    {
      "id": 13, "type": "timeseries", "title": "Espace disque",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 10},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})", "refId": "A", "legendFormat": "{{instance}} {{mountpoint}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "percent", "min": 0, "max": 100}}
    },
    {"id": 20, "type": "row", "title": "Redémarrages", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}},
    {
      "id": 21, "type": "timeseries", "title": "Redémarrages (5 min)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 19},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "sum by (namespace, pod) (kube_pod_container_status_restarts_total)", "refId": "A", "legendFormat": "{{namespace}}/{{pod}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}}
    }
  ]
}
