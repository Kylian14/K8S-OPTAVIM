{
  "uid": "opta-apps-php",
  "title": "OPTAVIM — Applications métier",
  "tags": ["optavim", "apps"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "templating": {"list": [
    {"name": "datasource", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}, "hide": 0}
  ]},
  "links": [{"title": "Executive", "url": "/d/opta-exec", "type": "link", "icon": "external link"}],
  "panels": [
    {
      "id": 10, "type": "timeseries", "title": "CPU par application",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"apps\",container!~\"|POD\"}[5m]))", "refId": "A", "legendFormat": "{{pod}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}}
    },
    {
      "id": 11, "type": "timeseries", "title": "Mémoire par application",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [{"expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"apps\",container!~\"|POD\"})", "refId": "A", "legendFormat": "{{pod}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "bytes"}}
    }
  ]
}
